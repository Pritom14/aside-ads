# Copy to .env (read from the working directory) or export these variables.
# Everything is optional: with no settings Aside uses SQLite in ./.aside and in-process counters.

# Storage
# DATABASE_URL=postgresql+asyncpg://aside:aside@127.0.0.1:5432/aside
# REDIS_URL=redis://127.0.0.1:6379/0
# ASIDE_DATA_DIR=.aside

# Security: HMAC key for tracking tokens, user-id hashing and dashboard sessions.
# Auto-generated into $ASIDE_DATA_DIR/secret.key when unset. Set it when running several instances.
# ASIDE_SECRET_KEY=
# Public base URL used in impression/click links (defaults to the request URL).
# ASIDE_PUBLIC_URL=https://ads.example.com
# ASIDE_TRUST_PROXY_HEADERS=false

# Matching
# ASIDE_MATCHER=auto                      # auto | embedding | bm25
# ASIDE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ASIDE_RELEVANCE_THRESHOLD=              # default 0.65 (embedding) or 0.5 (bm25)
# ASIDE_SENSITIVE_CATEGORIES=self_harm,medical_emergency,serious_illness,minors,abuse_violence,grief,addiction,financial_distress
# ASIDE_SENSITIVE_TERMS_FILE=./sensitive_terms.json
# ASIDE_SENSITIVE_THRESHOLD=0.70

# Auction, budgets, tracking
# ASIDE_CURRENCY=USD
# ASIDE_FLOOR_CPM=0.50
# ASIDE_DEFAULT_CTR=0.01
# ASIDE_TIMEZONE=UTC
# ASIDE_PACING_BUFFER=0.0416
# ASIDE_RESERVATION_TTL=120             # seconds a served CPM ad holds its cost; 0 = off
# ASIDE_CPC_EXPECTED_CTR=0.05           # CPC serves hold bid x this
# ASIDE_CPC_EXPOSURE_TTL=900            # seconds a served CPC ad holds it; 0 = off
# ASIDE_IMPRESSION_TOKEN_TTL=3600
# ASIDE_CLICK_TOKEN_TTL=86400
# ASIDE_CONVERSION_WINDOW_DAYS=30
# ASIDE_RATE_LIMIT_PER_MINUTE=120
# ASIDE_CLICK_ID_PARAM=aside_click_id

# Chat demo (examples/chat-demo): any OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
